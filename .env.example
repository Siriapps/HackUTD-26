# Gemini (AI Studio key; Live API works on free tier)
GEMINI_API_KEY=
# Optional Gemini overrides. Defaults confirmed against aistudio.google.com/docs on 2026-11-07.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_API_VERSION=v1alpha
# Shared secret the Meta glasses app sends as x-field-token to /api/gemini/glasses. Required outside `next dev`.
FIELD_DEVICE_TOKEN=

# Discord incoming webhook for alert dispatch
DISCORD_WEBHOOK_URL=
# Public URL used in Discord / Photon deep links (defaults to the request origin)
PUBLIC_BASE_URL=

# Photon (iMessage / voice / email dispatch). Project key pho_sk_..., project id pho_prj_...
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# whsec_... returned once when the webhook destination is created (npm run photon:webhook)
PHOTON_WEBHOOK_SECRET=
# Sender agent user (pho_usr_...) for the iMessage line; resolved automatically if empty
PHOTON_SENDER_ID=
# Required to use /api/photon/send outside dev (sent as x-send-token)
PHOTON_SEND_TOKEN=

# Dispatch roster overrides (E.164). Empty = use config/ops-roster.json
# On-call tech for pump-failure alerts
DISPATCH_ONCALL_HANDLE=
# Supervisor paged on escalation (must have texted the Photon line once if it's a shared line)
DISPATCH_SUPERVISOR_HANDLE=
# Compress escalation timing for demos: 60 = a 5-min window fires in 5 s
DISPATCH_TIME_SCALE=1
# Morning crew for the shift handoff (comma-separated E.164)
DISPATCH_HANDOFF_HANDLE=
# Daily handoff text at this server-local time (set TZ), e.g. 06:00. Empty = button only
DISPATCH_HANDOFF_AT=
# 1 = also ring the tech (AI night engineer) when a text goes unanswered. Default off: the alert text
# carries PHOTON_VOICE_NUMBER and the tech calls when they want to.
DISPATCH_AUTO_CALL=0

# Phone agent (AI night engineer) via ElevenLabs over the Photon voice line. `npm run voice:agent` fills the IDs.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Signing secret of the ElevenLabs post-call webhook (call recaps); optional
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret ElevenLabs sends to /api/voice/* (generated by the script)
VOICE_TOOL_SECRET=
# Photon voice line (E.164). Printed in alert texts as the number to call; also the SIP trunk for the number import
PHOTON_VOICE_NUMBER=
PHOTON_SIP_ADDRESS=
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=

# Tiger Data (TimescaleDB on Tiger Cloud) — persistence layer
DATABASE_URL=

# GitHub tickets (POST /api/ticket)
GITHUB_TOKEN=
TICKET_REPO=Siriapps/HackUTD-26
