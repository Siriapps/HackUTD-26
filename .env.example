# Gemini (AI Studio key; Live API works on free tier)
GEMINI_API_KEY=
# Optional Gemini overrides. Defaults confirmed against aistudio.google.com/docs on 2026-11-07.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_API_VERSION=v1alpha
# Discord incoming webhook for alert dispatch
DISCORD_WEBHOOK_URL=
# Public URL used in Discord deep links (defaults to the request origin)
PUBLIC_BASE_URL=
# Photon (iMessage / voice / email dispatch). Project key pho_sk_..., project id pho_prj_...
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# whsec_... returned once when the webhook destination is created (npm run photon:webhook)
PHOTON_WEBHOOK_SECRET=
# Sender agent user (pho_usr_...) for the iMessage line; resolved automatically if empty
PHOTON_SENDER_ID=
# Tiger Data (TimescaleDB on Tiger Cloud) — persistence layer
DATABASE_URL=
# GitHub tickets
GITHUB_TOKEN=
TICKET_REPO=Siriapps/HackUTD-26

PHOTON_SEND_TOKEN=
DISPATCH_ONCALL_HANDLE=
# Required to use /api/photon/send outside dev (sent as x-send-token)
# On-call tech for alerts (E.164). Overrides config/ops-roster.json
# Supervisor paged on escalation (must have texted the Photon line once if it's a shared line)
DISPATCH_SUPERVISOR_HANDLE=
# Compress escalation timing for demos: 60 = a 5-min window fires in 5 s
DISPATCH_TIME_SCALE=1
